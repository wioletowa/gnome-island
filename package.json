{
  "name": "gnome-island",
  "version": "0.1.0",
  "description": "Dynamic Island for GNOME Shell that replaces the top bar",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc && node scripts/assemble.mjs",
    "check": "tsc --noEmit",
    "install-ext": "npm run build && node scripts/assemble.mjs --install",
    "pack": "npm run build && node scripts/assemble.mjs --pack"
  },
  "devDependencies": {
    "@girs/gjs": "^4.0.0-beta.38",
    "@girs/gnome-shell": "^50.0.4",
    "typescript": "^5.9.0"
  }
}
